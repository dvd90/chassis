# ── Chassis web configuration ──────────────────────────────────────
# Copy this file to `.env.local`. Only the auth provider this project was
# scaffolded with is listed below — the others were pruned.

# The Chassis API. Read on the server only, so it is never shipped to the
# browser and does not need the NEXT_PUBLIC_ prefix.
API_URL=http://localhost:8000

# ── Local auth ─────────────────────────────────────── chassis:session
# Nothing to configure: the /api/session routes exchange credentials at # chassis:session
# the API and store the tokens in httpOnly cookies. The signing secret  # chassis:session
# stays on the API side (JWT_SECRET) — never here.                      # chassis:session

# ── Auth0 ───────────────────────────────────────────── chassis:auth0
AUTH0_DOMAIN=                                            # chassis:auth0
AUTH0_CLIENT_ID=                                         # chassis:auth0
AUTH0_CLIENT_SECRET=                                     # chassis:auth0
# Must match AUTH0_AUDIENCE on the API. Without it Auth0 returns an ID # chassis:auth0
# token and every @protectedRoute call is rejected.                    # chassis:auth0
AUTH0_AUDIENCE=                                          # chassis:auth0
# Session cookie encryption key — `openssl rand -hex 32`. # chassis:auth0
AUTH0_SECRET=                                            # chassis:auth0
APP_BASE_URL=http://localhost:3000                       # chassis:auth0

# ── Clerk ───────────────────────────────────────────── chassis:clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=                       # chassis:clerk
CLERK_SECRET_KEY=                                        # chassis:clerk
